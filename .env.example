# Copy to .env.local and edit. .env.local is gitignored, so nothing here is
# committed — keep personal details in that file, not this one.

# Sent to MusicBrainz in the User-Agent on every request. They ask for a way to
# contact whoever is running the client, and throttle harder (or block) clients
# that don't identify themselves. A repo or homepage URL counts as contact just
# as an email does — it does not have to be personal.
#
# This is already the built-in default, so you only need to set it if you want
# to be reachable more directly, e.g.
#   MUSICBRAINZ_CONTACT=you@example.com
MUSICBRAINZ_CONTACT=https://github.com/jimbo8e6/music

# Where the SQLite file lives, relative to the project root.
# DATABASE_URL=./wax.db

# Set to 1 to skip Next's image optimiser and load cover art directly. Useful
# behind a proxy or network policy that blocks the Internet Archive CDN.
# NEXT_PUBLIC_UNOPTIMIZED_IMAGES=1
